    <!--
    Had to copy info from MechanitesBase and change some stuff because values were too long
    -->
    
    <HediffDef ParentName="InfectionBase">
        <defName>TKKN_Allergies</defName>
        <label>allergies</label>
        <description>The immune system is overreacting!</description>
        <hediffClass>HediffWithComps</hediffClass>
        <makesSickThought>true</makesSickThought>
        <makesAlert>false</makesAlert>
        <minSeverity>0.001</minSeverity>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>0.001</initialSeverity>
        <tendable>true</tendable>
        <stages>
            <li>
                <label>stuffed up head</label>
                <restFallFactorOffset>0.85</restFallFactorOffset>
                <capMods>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.2</offset>
                    </li>
                    <li>
                        <capacity>Breathing</capacity>
                        <offset>-0.2</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>300000~900000</disappearsAfterTicks>
            </li>
            <li Class="HediffCompProperties_TendDuration">
                <baseTendDurationHours>48</baseTendDurationHours>
                <severityPerDayTended>-1.0</severityPerDayTended>
            </li>
            <li Class="HediffCompProperties_Immunizable">
                <severityPerDayNotImmune>0.25</severityPerDayNotImmune>
            </li>
        </comps>
    </HediffDef>
    
