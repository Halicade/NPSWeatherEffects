<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <TileMutatorDef Name="NPSSpringMutators" Abstract="True">
        <categories>
            <li>Lake</li>
        </categories>
        <chanceOnNonLandmarkTile>1</chanceOnNonLandmarkTile>
        <coastSidesRange>0~0</coastSidesRange>
        <biomeBlacklist>
            <li>Ocean</li>
            <li>SeaIce</li>
            <li>Desert</li>
            <li MayRequire="hali.npsbiomes">TKKN_Desert</li>
            <li MayRequire="hali.npsbiomes">TKKN_Oasis</li>
            <li MayRequire="biomesteam.oasis">BMT_ChromaticOasis</li>
            <li MayRequire="zylle.morevanillabiomes">ZBiome_Badlands</li>
            <li MayRequire="zylle.morevanillabiomes">ZBiome_DesertOasis</li>
            <li MayRequire="zylle.morevanillabiomes">ZBiome_Iceberg_NoBeach</li>
        </biomeBlacklist>
    </TileMutatorDef>

    <TileMutatorDef>
        <defName>NPS_HotSpringMutator</defName>
        <label>hot spring</label>
        <description>Hot springs can be found in the area. These provide rest and improve injuries.</description>
        <chanceOnNonLandmarkTile>1</chanceOnNonLandmarkTile>
        <extraGenSteps>
            <li>NPS_HotSpring</li>
            <li>NPS_PostSpringPlants</li>
        </extraGenSteps>
        <averageTemperatureRange>-999~17.5</averageTemperatureRange>
    </TileMutatorDef>

    <TileMutatorDef>
        <defName>NPS_ColdSpringMutator</defName>
        <label>cold spring</label>
        <description>Cold springs can be found in the area. These provide rest and improve injuries.</description>
        <workerClass>NPSWeather.GiveMePlants</workerClass>
        <extraGenSteps>
            <li>NPS_ColdSpring</li>
            <li>NPS_PostSpringPlants</li>
        </extraGenSteps>
        <additionalWildPlants>
            <NPS_ColdSpringAmbrosia>0.02</NPS_ColdSpringAmbrosia>
        </additionalWildPlants>
        <averageTemperatureRange>17.51~999</averageTemperatureRange>
        <biomeBlacklist>
            <li MayRequire="hali.npsbiomes">TKKN_VolcanicFlow</li>
            <li MayRequire="biomesteam.biomescaverns">BMT_EarthenDepths</li>
        </biomeBlacklist>
    </TileMutatorDef>


    <TileMutatorDef Name="NPS_TidalLevels" Abstract="True">
        <priority>5</priority>
        <categories>
            <li>Coast</li>
        </categories>
        <overrideCategories>
            <li>Mountain</li>
        </overrideCategories>
        <coastSidesRange>1~5</coastSidesRange>
        <biomeBlacklist>
            <li>Ocean</li>
            <li>SeaIce</li>
            <li>IceSheet</li>
            <li MayRequire="hali.npsbiomes">TKKN_VolcanicFlow</li>
            <li MayRequire="hali.npsbiomes">TKKN_Desert</li>
            <li MayRequire="hali.npsbiomes">TKKN_Oasis</li>
            <li MayRequire="zylle.morevanillabiomes">ZBiome_Iceberg_NoBeach</li>
        </biomeBlacklist>
        <workerClass>TileMutatorWorker_Coast</workerClass>
        <chanceOnNonLandmarkTile>0.01</chanceOnNonLandmarkTile>
    </TileMutatorDef>

    <TileMutatorDef ParentName="NPS_TidalLevels">
        <defName>NPS_WeakOceanTide</defName>
        <label>weak tide</label>
        <description>The tide levels are weaker here. Less resources are likely to show up on the shore as a result.</description>

        <modExtensions>
            <li Class="NPSWeather.MutatorSettings">
                <tideFactor>0.75</tideFactor>
            </li>
        </modExtensions>
    </TileMutatorDef>

    <TileMutatorDef ParentName="NPS_TidalLevels">
        <defName>NPS_StrongOceanTide</defName>
        <label>strong tide</label>
        <description>The tide levels are stronger here. More resources are likely to show up on the shore as a result.</description>
        <biomeBlacklist>
            <li>Desert</li>
        </biomeBlacklist>
        <modExtensions>
            <li Class="NPSWeather.MutatorSettings">
                <tideFactor>1.25</tideFactor>
            </li>
        </modExtensions>
    </TileMutatorDef>

    <TileMutatorDef ParentName="NPS_TidalLevels">
        <defName>NPS_DiurnalTide</defName>
        <label>diurnal tide</label>
        <description>The tidal levels follow a diurnal cycle. There is only one tidal cycle each lunar day.</description>
        <modExtensions>
            <li Class="NPSWeather.MutatorSettings">
                <tideVariant>Diurnal</tideVariant>
            </li>
        </modExtensions>
    </TileMutatorDef>

    <TileMutatorDef ParentName="NPS_TidalLevels">
        <defName>NPS_MixedSemidiurnal</defName>
        <label>mixed semidiurnal tide</label>
        <description>The tidal levels follow a mixed semidiurnal cycle. It experiences two high and two low tides of different size each lunar day.</description>
        <modExtensions>
            <li Class="NPSWeather.MutatorSettings">
                <tideVariant>MixedSemiDiurnal</tideVariant>
            </li>
        </modExtensions>
    </TileMutatorDef>


</Defs>