<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="EtherealThingBase">
    <defName>TKKN_DustDevil</defName>
    <label>dustdevil</label>
    <thingClass>NPSWeather.DustDevil</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <drawOffscreen>true</drawOffscreen>
    <seeThroughFog>true</seeThroughFog>
    <alwaysFlee>true</alwaysFlee>
    <comps>
      <li Class="CompProperties_WindSource" />
    </comps>
  </ThingDef>
  
  <ThingDef ParentName="BuildingBase">
    <defName>TKKN_Sculpture_Shell</defName>
    <label>sea shell</label>
    <description>The beautiful, hard, protective shell of long dead sea animals.</description>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>TKKN_NPS/Things/Sculptures/Shells</texPath>
      <drawRotated>false</drawRotated>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <fillPercent>0.15</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <hasInteractionCell>false</hasInteractionCell>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <building>
      <repairable>false</repairable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <MarketValue>200</MarketValue>
      <Mass>7.5</Mass>
      <Beauty>50</Beauty>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>NPS_MessageInABottle</defName>
    <label>message in a bottle</label>
    <description>A weathered bottle that washed up on the shore; it contains a message inside. The bottle is fragile and can't be repaired.</description>
    <thingClass>Building_Art</thingClass>
    <inspectorTabs>
      <li>ITab_Art</li>
    </inspectorTabs>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>TKKN_NPS/Things/Sculptures/MessageInABottle</texPath>
      <drawRotated>true</drawRotated>
      <damageData>
        <enabled>false</enabled>
      </damageData>
      <drawOffset>(0, 1, 0.25)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <fillPercent>0.15</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <building>
      <repairable>false</repairable>
      <expandHomeArea>false</expandHomeArea>
      <isEdifice>false</isEdifice>
    </building>
    <clearBuildingArea>false</clearBuildingArea>
    <comps>
      <li Class="NPSWeather.CompProperties_BottleMessage">
        <canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
      </li>
    </comps>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <MarketValue>200</MarketValue>
      <Mass>7.5</Mass>
      <Beauty>10</Beauty>
    </statBases>
  </ThingDef>

</Defs>
