    <TaleDef>
        <defName>TKKN_Drought</defName>
        <label>drought</label>
        <taleClass>Tale_SinglePawn</taleClass>
        <type>Volatile</type>
        <baseInterest>5</baseInterest>
        <rulePack>
            <rulesStrings>
                <li>tale_noun->[pawn_nameShortDef] stares at the sky, hoping for rain</li>
                <li>tale_noun->a dry wind blows around [pawn_nameShortDef]'s [community]</li>
                <li>tale_noun->the plants are slowing drying out at [pawn_nameShortDef]'s [community]</li>
                <li>tale_noun->[pawn_nameShortDef]'s [community] stuggles to water their animals</li>
                <li>image->a dry wind blows [circumstance_phrase]</li>
                <li>image->a clear sky and merciless sun beats down [circumstance_phrase]</li>
                <li>image->cracked soil [circumstance_phrase]</li>
                <li>image->wilting plants [circumstance_phrase]</li>
                <li>circumstance_phrase->near a [terrainfeature]</li>
                <li>circumstance_phrase->close to [terrainfeature]</li>
                <li>circumstance_phrase->around the dying countryside of [community]</li>
                <li>circumstance_phrase->between [terrainfeature] and a [terrainfeature]</li>
                <li>desc_sentence->In the dust, [pawn_nameShortDef] plays [game] with a [friendlyadjective] look.</li>
                <li>desc_sentence->[pawn_nameShortDef] prays for rain, need on [pawn_possessive] face.</li>
                <li>desc_sentence->[quantity_adjphrase] [outlander]s watch from below.</li>
                <li>desc_sentence->[pawn_nameShortDef] sits near a [terrainfeature], pouring dried dirt through [pawn_possessive] fingers.</li>
                <li>desc_sentence->[quantity_adjphrase] [animal]s are leaving the area, or dying of thirst.</li>
                <li>desc_sentence->There is no [enemy] in sight.</li>
            </rulesStrings>
        </rulePack>
    </TaleDef>

    <TaleDef>
        <defName>NPS_Rainbow</defName>
        <label>rainbow</label>
        <taleClass>Tale_SinglePawn</taleClass>
        <type>Volatile</type>
        <baseInterest>20</baseInterest>
        <rulePack>
            <rulesStrings>
                <li>tale_noun->the time a rainbow appeared over [PAWN_nameDef]'s [Community]</li>
                <li>tale_noun->the time a rainbow shone over [PAWN_nameDef]'s [Community]</li>
                <li>tale_noun->[PAWN_nameDef]'s [Community] witnessing the majesty of a rainbow</li>
                <li>image->the sky painted in [NPSRainbow]s and [NPSRainbow]s [circumstance_phrase]</li>
                <li>image->a fabulous spectrum of [NPSRainbow] rays [circumstance_phrase]</li>
                <li>image->a collection of vibrant colors [circumstance_phrase]</li>
                <li>image->[NPSRainbow] swooping arcs with [NPSRainbow] highlights [circumstance_phrase]</li>
                <li>image->radiant [NPSRainbow] lights [circumstance_group]</li>
                <li>circumstance_phrase->over a [TerrainFeature]</li>
                <li>circumstance_phrase->illuminating a [TerrainFeature]</li>
                <li>circumstance_phrase->floating over a [Community]</li>
                <li>circumstance_phrase->bracketed between a [TerrainFeature] and a [TerrainFeature]</li>
                <li>desc_sentence->Below, [PAWN_nameDef] plays [Game] with a [AdjectiveFriendly] look.</li>
                <li>desc_sentence->[PAWN_nameDef] watches with awe on [PAWN_possessive] face.</li>
                <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s watch from below.</li>
                <li>desc_sentence->[PAWN_nameDef] sits near a [TerrainFeature], gazing at the sky.</li>
                <li>desc_sentence->[Quantity_adjphrase] [Animal]s wander peacefully.</li>
                <li>desc_sentence->There is no [Enemy] in sight.</li>
                <li>NPSRainbow->red</li>
                <li>NPSRainbow->orange</li>
                <li>NPSRainbow->yellow</li>
                <li>NPSRainbow->blue</li>
                <li>NPSRainbow->indigo</li>
                <li>NPSRainbow->violet</li>
            </rulesStrings>
        </rulePack>
    </TaleDef>
</Defs>