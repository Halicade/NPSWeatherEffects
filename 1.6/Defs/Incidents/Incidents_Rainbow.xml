<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <GameConditionDef>
        <defName>NPS_Rainbow</defName>
        <conditionClass>NPSWeather.GameCondition_Rainbow</conditionClass>
        <label>rainbow</label>
        <description>A rainbow is appearing in th sky. The beautiful colors will boost the mood of anyone outside to see it.</description>
        <endMessage>The rainbow is fading.</endMessage>
        <letterText>A beautiful rainbow has appeared in the sky.\n\nThe beautiful colors will boost the mood of anyone outside to see it.</letterText>
        <letterDef>PositiveEvent</letterDef>
        <canBePermanent>true</canBePermanent>
        <allowUnderground>false</allowUnderground>
        <canAffectAllPlanetLayers>true</canAffectAllPlanetLayers>
        <silencedByConditions>
            <li MayRequire="Ludeon.RimWorld.Anomaly">UnnaturalDarkness</li>
            <li>Eclipse</li>
        </silencedByConditions>
    </GameConditionDef>

    <IncidentDef>
        <defName>NPS_Rainbow</defName>
        <label>rainbow</label>
        <category>Misc</category>
        <targetTags>
            <li>World</li>
        </targetTags>
        <workerClass>NPSWeather.IncidentWorker_Rainbow</workerClass>
        <gameCondition>NPS_Rainbow</gameCondition>
        <letterLabel>Rainbow</letterLabel>
        <letterDef>PositiveEvent</letterDef>
        <baseChance>1.2</baseChance>
        <minRefireDays>15</minRefireDays>
        <durationDays>0.125~0.35</durationDays>
        <tale>NPS_Rainbow</tale>
        <canOccurOnAllPlanetLayers>true</canOccurOnAllPlanetLayers>
    </IncidentDef>

    <ThoughtDef>
        <defName>NPS_Rainbow</defName>
        <workerClass>ThoughtWorker_Aurora</workerClass>
        <gameCondition>NPS_Rainbow</gameCondition>
        <stages>
            <li>
                <label>beautiful rainbow</label>
                <description>The colors are so pretty.</description>
                <baseMoodEffect>14</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>




</Defs>