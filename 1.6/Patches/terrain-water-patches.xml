<?xml version="1.0" encoding="UTF-8"?>

<Patch>
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterDeep"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterMovingChestDeep"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <freezeAt>-1</freezeAt>
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterShallow"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterMovingShallow"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <freezeAt>-1</freezeAt>
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "TKKN_ColdSpringsWater"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <temperatureAdjust>-10</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "TKKN_ColdSpringsWaterDeep"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <temperatureAdjust>-10</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "TKKN_HotSpringsWater"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_Ice</freezeTerrain>
                <freezeAt>-4</freezeAt>
                <temperatureAdjust>10</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterOceanShallow"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <tideTerrain>NPS_WaterOceanTide</tideTerrain>
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterOceanDeep"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "Marsh"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>TKKN_MuddyIce</freezeTerrain>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[@Name = "WaterBase"]/tags</xpath>
        <value>
            <li>NPS_Water</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/TerrainDef[@Name="WaterDeepBase"]/tags</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/TerrainDef[@Name="WaterDeepBase"]</xpath>
            <value>
                <tags />
            </value>
        </nomatch>
    </Operation>

    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[@Name="WaterDeepBase"]/tags</xpath>
        <value>
            <li>NPS_DeepWater</li>
        </value>
    </Operation>
    
</Patch>