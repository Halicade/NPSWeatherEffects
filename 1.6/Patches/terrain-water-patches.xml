    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "TKKN_ColdSpringsWater"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>
                    <terrain>TKKN_Ice</terrain>
                </freezeTerrain>
                <temperatureAdjust>-10</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "TKKN_ColdSpringsWaterDeep"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>
                    <terrain>TKKN_Ice</terrain>
                </freezeTerrain>
                <temperatureAdjust>-10</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "TKKN_HotSpringsWater"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <freezeTerrain>
                    <terrain>TKKN_Ice</terrain>
                    <freezeAt>-4</freezeAt>
                </freezeTerrain>
                <temperatureAdjust>10</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterOceanShallow"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <tideTerrain>TKKN_SandBeachWetSalt</tideTerrain>
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "WaterOceanDeep"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <temperatureAdjust>-5</temperatureAdjust>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainDef[defName = "Marsh"]</xpath>
        <value>
            <li Class="NPSWeather.TerrainWeatherReactions">
                <floodTerrain>WaterShallow</floodTerrain>
                <freezeTerrain>
                    <terrain>TKKN_MuddyIce</terrain>
                </freezeTerrain>
            </li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[@Name = "WaterBase"]/tags</xpath>
        <value>
            <li>TKKN_Wet</li>
            <li>TKKN_Swim</li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[defName = "Marsh"]/tags</xpath>
        <value>
            <li>TKKN_Wet</li>
        </value>
    </Operation>
    
