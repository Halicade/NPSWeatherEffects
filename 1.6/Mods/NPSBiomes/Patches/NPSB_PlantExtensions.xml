<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName = "TKKN_PlantDesertShrubA"]/thingClass</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName = "TKKN_PlantDesertShrubA"]</xpath>
            <value>
                <thingClass>NPSWeather.PlantEffects</thingClass>
            </value>
        </nomatch>
    </Operation>
    
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/ThingDef[defName = "TKKN_PlantDesertShrubA"]</xpath>
        <value>
            <li Class="NPSWeather.ThingWeatherReaction">
                <droughtGraphicPath>TKKN_NPS/Things/Plant/VarientDrought/DesertShrubA</droughtGraphicPath>
            </li>
        </value>
    </Operation>

